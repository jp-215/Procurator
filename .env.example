# --- MongoDB Atlas (hackathon sandbox, M0) ---
MONGODB_URI=""
MONGODB_DB="procurator"

# --- Embeddings (Voyage AI, MongoDB-owned) ---
VOYAGE_API_KEY=""
VOYAGE_MODEL="voyage-3.5"
VOYAGE_DIMS="1024"

# --- Agents ---
ANTHROPIC_API_KEY=""
PROCURATOR_MODEL="claude-opus-5"
WORKER_MODEL="claude-sonnet-5"

# --- Governor ---
BUDGET_TOTAL_TOKENS="1000000"
WIDTH_MAX="8"
LEASE_SECONDS="300"
HEARTBEAT_SECONDS="30"

# --- Ablation switch for the money-shot chart ---
MEMORY_ENABLED="true"

# Only needed if ANTHROPIC_API_KEY is org-scoped (not workspace-scoped)
ANTHROPIC_WORKSPACE_ID=""
