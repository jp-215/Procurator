# --- MongoDB Atlas (hackathon sandbox, M0) ---
MONGODB_URI=""
MONGODB_DB="procurator"

# --- Embeddings (Voyage AI, MongoDB-owned) ---
VOYAGE_API_KEY=""
VOYAGE_MODEL="voyage-3.5"
VOYAGE_DIMS="1024"

# --- Agents ---
ANTHROPIC_API_KEY=""
PROCURATOR_MODEL="claude-opus-5"
WORKER_MODEL="claude-sonnet-5"

# --- Governor ---
BUDGET_TOTAL_TOKENS="1000000"
WIDTH_MAX="8"
LEASE_SECONDS="300"
HEARTBEAT_SECONDS="30"

# --- Ablation switch for the money-shot chart ---
MEMORY_ENABLED="true"

# Only needed if ANTHROPIC_API_KEY is org-scoped (not workspace-scoped)
ANTHROPIC_WORKSPACE_ID=""

# --- Voice layer (Twilio + ElevenLabs) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""        # the Twilio number callers dial
STAKEHOLDER_PHONE=""          # your phone; PM calls it at sprint close (optional)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="JBFqnCBsd6RMkjVDRZzb"   # default: George
PUBLIC_BASE_URL=""            # e.g. https://xxxx.ngrok.app  (ngrok http 8787)

# --- Mesh output repo (so the mesh never writes to THIS repo) ---
TARGET_REPO_DIR=""            # e.g. /Users/you/procurator-workbench ; empty = ./target (legacy)
TARGET_REPO_REMOTE=""         # e.g. https://github.com/jp-215/procurator-workbench.git
